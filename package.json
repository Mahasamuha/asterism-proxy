{
  "name": "mcp-auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm --filter @mcp-auth/proxy dev",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "body-parser@2": "^2.4.0",
      "proxy-addr@2": "^2.0.8",
      "qs@6": "^6.16.0",
      "fast-uri@3": "^3.1.9",
      "mysql2@3": "^3.23.1",
      "brace-expansion@2": "^2.1.7",
      "deepmerge-ts@7": "^8.0.0"
    }
  }
}
