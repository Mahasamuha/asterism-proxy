<%
  var _heading = (hasGrant && !isDevice) ? ('Continue to ' + clientName + '?') : (clientName + ' wants to access ' + resourceServerName);
-%>
<%- include('partials/top', { title: _heading }) %>
    <div class="panel">
      <% if (logoUri) { %>
        <img class="client-logo" src="<%= logoUri %>" alt="">
      <% } %>
      <% if (isDevice && userCode) { %>
        <p class="eyebrow">code shown on your device</p>
        <p class="user-code"><%= userCode %></p>
        <%- include('partials/banner', { status: 'warning', title: null, text: 'Confirm that this code matches the code shown on your device. If you did not start this on your own device, or the codes differ, choose Deny.' }) %>
      <% } %>
      <div class="facts">
        <% if (clientDomain) { %>
          <p>Requesting client at <strong><%= clientDomain %></strong></p>
        <% } %>
        <% if (claimedBy) { %>
          <p>Client identity as claimed by <strong><%= claimedBy %></strong> (not independently verified)</p>
        <% } %>
        <% if (redirectHost) { %>
          <p>After approval you'll be sent to <strong><%= redirectHost %></strong></p>
        <% } %>
      </div>
      <% if (isLoopbackRedirect) { %>
        <%- include('partials/banner', { status: 'warning', title: null, text: 'The app receiving this authorization runs on this device. Only approve if you started it.' }) %>
      <% } %>
      <% if (unverified) { %>
        <%- include('partials/banner', { status: 'warning', title: null, text: "This client's identity has not been verified. Only approve if you recognize and trust it." }) %>
      <% } %>
      <p>This will allow access to <strong><%= resourceServerName %></strong> with the following permissions:</p>
      <ul class="scope-list">
        <% scopes.forEach(function(scope) { %>
          <li><%= scope.description %></li>
        <% }) %>
      </ul>
      <% if (releasedClaims && releasedClaims.length) { %>
        <p><%= clientName %> and <%= resourceServerName %> will receive these details from your account: <%= releasedClaims.join(", ") %></p>
      <% } %>
      <form id="consent-form" method="POST" action="/oauth/consent">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <input type="hidden" name="flow" value="<%= flow %>">
        <div class="actions">
          <button class="ghost" type="submit" name="action" value="deny">deny</button>
          <button type="submit" name="action" value="approve"><%= (isDevice && userCode) ? "the code matches · approve →" : "approve →" %></button>
        </div>
      </form>
    </div>
    <script><%- consentFormScript %></script>
<%- include('partials/bottom') %>
