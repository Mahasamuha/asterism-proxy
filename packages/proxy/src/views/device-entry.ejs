<%- include('partials/top', { title: 'Enter the code shown on your device', error: error || null }) %>
    <div class="panel">
      <form method="POST" action="/oauth/device">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <label for="user_code">Code</label>
        <input id="user_code" name="user_code" class="code-entry" type="text" value="<%= userCode %>" placeholder="XXXX-XXXX" autocomplete="off" autofocus required>
        <p class="actions"><button type="submit" class="wide">continue →</button></p>
      </form>
    </div>
<%- include('partials/bottom') %>
