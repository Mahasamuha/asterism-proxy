<%# EmptyState: an invitation, not an apology. title names the space; text is one line; action { href, text } is optional. -%>
<div class="empty">
  <%# The network mark on paper; on ink the network alone is hard to see, so the dark mark (with its field), as the EmptyState component does. -%>
  <picture>
    <source srcset="/assets/brand/mahasamuha-mark-dark.svg" media="(prefers-color-scheme: dark)">
    <img src="/assets/brand/mahasamuha-mark-network.svg" width="48" height="48" alt="">
  </picture>
  <p class="title"><%= title %></p>
  <% if (typeof text !== "undefined" && text) { %><p class="text"><%= text %></p><% } %>
  <% if (typeof action !== "undefined" && action) { %><p class="actions"><a class="button" href="<%= action.href %>"><%= action.text %></a></p><% } %>
</div>
