<%- include('_head', { title: 'Resource servers' }) %>
    <p><a href="/admin/resource-servers/new">Approve a new server</a></p>
    <table>
      <thead><tr><th>Server</th><th>Status</th><th>Metadata</th><th>Gated scopes</th><th>Released claims</th><th>Flags</th></tr></thead>
      <tbody>
      <% if (servers.length === 0) { %>
        <tr><td colspan="6">No resource servers are approved.</td></tr>
      <% } %>
      <% servers.forEach(function (s) { %>
        <% var gated = s.scopes.filter(function (sc) { return sc.requireGroups.length > 0; }); %>
        <tr>
          <td><a href="/admin/resource-servers/<%= s.id %>"><%= s.displayName %></a><br><code><%= s.identifier %></code></td>
          <td>
            <span class="tag<%= s.enabled ? '' : ' bad' %>"><%= s.enabled ? 'enabled' : 'disabled' %></span>
            <% if (s.internal) { %><span class="tag">internal</span><% } %>
          </td>
          <td>
            <% if (!s.hasSnapshot) { %><span class="tag bad">no snapshot</span><% } else { %>fetched <%= s.age %><% } %>
            <% if (s.stale) { %><span class="tag bad">STALE: expired <%= s.staleFor %> ago</span><% } %>
            <% if (s.pending) { %><br><span class="tag bad">changes waiting for approval</span><% } %>
            <% if (s.lastFetchError) { %><br><span class="error"><%= s.lastFetchError %></span><% } %>
          </td>
          <td><%= gated.length === 0 ? 'none' : gated.map(function (sc) { return sc.name; }).join(', ') %></td>
          <td><%= s.releaseClaims.length === 0 ? 'none' : s.releaseClaims.join(', ') %></td>
          <td>
            <% if (s.undeclaredPolicies.length > 0) { %><span class="tag bad">policy on undeclared scope: <%= s.undeclaredPolicies.map(function (p) { return p.scopeName; }).join(', ') %></span><% } %>
          </td>
        </tr>
      <% }); %>
      </tbody>
    </table>
<%- include('_foot') %>
