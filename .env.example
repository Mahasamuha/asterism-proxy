# With docker compose, the asterism-proxy service does NOT load this whole file. It gets
# only the application settings listed under `environment:` in docker-compose.yml
# (plus a DATABASE_URL built there), so POSTGRES_USER, POSTGRES_PASSWORD and
# POSTGRES_DB stay with the postgres service. When you add a setting here that
# the proxy should see, add its name to that list too. See docs/deployment.md.

PORT=3000
LOG_LEVEL=info
ISSUER_URL=http://localhost:3000

# Signs the login session cookie. Required, at least 32 characters.
# Generate one with: openssl rand -hex 32
# COOKIE_SECRET=

# Number of reverse-proxy hops in front of the app (e.g. 1 for a single ingress)
# or specific proxy addresses/CIDRs. Never "true" (see docs/deployment.md),
# so req.ip and login throttling see the real client address. Leave unset when
# the app is exposed directly. See https://expressjs.com/en/guide/behind-proxies.html
# TRUST_PROXY=1

# Optional bearer token (at least 32 characters) for GET /metrics. Leave unset
# to disable /metrics entirely (it then returns 404).
# Generate one with: openssl rand -hex 32
# METRICS_TOKEN=

# Optional guard for the first-account page (/setup, local accounts only), at
# least 32 characters. When set, /setup asks for it; wrong guesses are throttled
# per IP. When unset, whoever reaches a fresh instance first can create the
# admin account, and the proxy logs a warning at startup while none exists.
# Generate one with: openssl rand -hex 32
# SETUP_TOKEN=

POSTGRES_USER=mcp_auth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mcp_auth
DATABASE_URL=postgresql://mcp_auth:change-me@localhost:5432/mcp_auth

# At least one identity provider must be enabled (see PLAN.md §1.8, §6).
ENABLE_OIDC=true
OIDC_ISSUER=https://authentik.example.internal/application/o/mcp-auth/
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me

ENABLE_LOCAL_ACCOUNTS=false
ENABLE_DCR=false
# Development only: allows http: client metadata URLs to loopback addresses.
ALLOW_INSECURE_CLIENT_METADATA=false
